{
  "name": "bitboot",
  "version": "1.0.1",
  "description": "Rendezvous for a peer-to-peer network on the BitTorrent mainline DHT",
  "license": "MIT",
  "author": "Tint Foundation",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "check:dist": "sh cli/check-dist.sh",
    "verify": "bun run lint && bun run typecheck && bun run check:dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tintfoundation/bitboot.git"
  },
  "keywords": [
    "dht",
    "mainline",
    "bittorrent",
    "rendezvous",
    "bootstrap",
    "p2p"
  ],
  "dependencies": {
    "bittorrent-dht": "11.0.12"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "neostandard": "0.13.0",
    "typescript": "6.0.3"
  },
  "trustedDependencies": []
}
